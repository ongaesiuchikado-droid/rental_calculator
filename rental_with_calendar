<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>機材レンタル — カレンダー連動見積り</title>
<style>
  :root{--bg:#fff;--fg:#111;--muted:#666;--card:#fafafa}
  *{box-sizing:border-box}body{font-family:system-ui,-apple-system,Segoe UI,Roboto,"Hiragino Kaku Gothic ProN","Noto Sans JP",sans-serif;margin:0;color:var(--fg);background:var(--bg)}
  .wrap{max-width:1100px;margin:18px auto;padding:14px}
  header{display:flex;align-items:center;justify-content:space-between;gap:12px}
  h1{font-size:18px;margin:0}
  .layout{display:grid;grid-template-columns:360px 1fr;gap:14px;margin-top:14px}
  @media(max-width:900px){.layout{grid-template-columns:1fr} .calendar{order:0}}
  .panel{background:var(--card);border:1px solid #eee;padding:12px;border-radius:8px}
  .calendar{min-height:360px}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
  .cal-cell{padding:10px;border-radius:6px;text-align:center;cursor:pointer;border:1px solid transparent}
  .cal-cell:hover{border-color:#eee}
  .cal-head{font-size:12px;color:var(--muted);padding:6px 0;text-align:center}
  .today{outline:2px solid #ddd;border-radius:6px}
  .selected{background:#111;color:#fff}
  .mark{display:inline-block;width:8px;height:8px;border-radius:50%;background:#111;margin-top:6px}
  .small{font-size:13px;color:var(--muted)}
  .btn{display:inline-block;padding:8px 10px;border-radius:8px;border:1px solid #111;background:#111;color:#fff;text-decoration:none;cursor:pointer}
  .btn.ghost{background:transparent;color:var(--fg);border:1px solid #ddd}
  .items-list{display:grid;gap:8px;margin-top:8px}
  .item{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:8px;border:1px solid #f2f2f2;border-radius:8px}
  .meta{flex:1}
  .controls{display:flex;gap:6px;align-items:center}
  input[type=number]{width:64px;padding:6px;border-radius:6px;border:1px solid #ddd;text-align:center}
  select, input[type=search]{padding:8px;border-radius:6px;border:1px solid #ddd}
  .summary{margin-top:8px}
  .export{white-space:pre-wrap;border:1px dashed #ddd;padding:8px;border-radius:6px;margin-top:8px;font-size:13px;background:#fff}
  footer{margin-top:14px;color:var(--muted);font-size:13px;text-align:center}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>機材レンタル（カレンダー連動）</h1>
      <div class="small">日付を選んで → 機材を選択 → 予約でカレンダーに印が付きます</div>
    </div>
    <div>
      <button id="goToItems" class="btn">今選べない？機材一覧へ</button>
    </div>
  </header>

  <div class="layout">
    <!-- カレンダー -->
    <div class="panel calendar" id="calendarPanel">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <div>
          <button id="prev" class="btn ghost">＜</button>
          <button id="next" class="btn ghost">＞</button>
        </div>
        <div id="monthLabel" class="small"></div>
        <div>
          <button id="newBooking" class="btn ghost">予約を確認</button>
        </div>
      </div>

      <div class="cal-grid" id="calHead">
        <div class="cal-head">日</div><div class="cal-head">月</div><div class="cal-head">火</div><div class="cal-head">水</div><div class="cal-head">木</div><div class="cal-head">金</div><div class="cal-head">土</div>
      </div>

      <div class="cal-grid" id="calGrid" aria-live="polite"></div>

      <div style="margin-top:8px" class="small">選択日: <span id="selectedDate">未選択</span></div>
      <div style="margin-top:8px">
        <button id="chooseDate" class="btn" disabled>この日で機材を選ぶ</button>
        <button id="clearMarks" class="btn ghost">全予約クリア（ローカル）</button>
      </div>
    </div>

    <!-- 機材選択 -->
    <div class="panel" id="itemsPanel">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <input id="search" type="search" placeholder="検索: アンプ/マイク など" style="flex:1">
        <select id="duration" title="利用時間">
          <option value="12">12時間</option>
          <option value="24" selected>24時間</option>
          <option value="168">7日間</option>
        </select>
        <label class="small">会員
          <input id="member" type="checkbox" style="margin-left:6px">
        </label>
      </div>

      <div class="items-list" id="itemsList"></div>

      <div class="summary">
        <div class="small">合計: <strong id="total">¥0</strong></div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <button id="confirmBooking" class="btn" disabled>予約確定してカレンダーに印を付ける</button>
          <button id="backToCal" class="btn ghost">カレンダーに戻る</button>
        </div>
        <div class="export" id="exportArea" tabindex="0" aria-label="見積り内容">見積りを生成してください。</div>
      </div>
    </div>
  </div>

  <footer>ローカル保存（ブラウザ）方式。正式予約はスタッフと確認してください。</footer>
</div>

<script>
/* ---------- データ部分（必要なら金額をここで編集） ---------- */
const items = [
  { id:"YAMAHA-EMX5014C", cat:"MIXER", name:"YAMAHA EMX5014C", prices:{12:24000,24:30000,168:120000}, note:"12ch PA" },
  { id:"ROLAND-JC120", cat:"GUITAR AMP", name:"ROLAND JC-120", prices:{12:5400,24:7200,168:28000}, note:"クリーン名機" },
  { id:"VOX-AC30CC2", cat:"GUITAR AMP", name:"VOX AC30 CC2", prices:{12:7200,24:9600,168:38000}, note:"ブリティッシュ" },
  { id:"ORANGE-ROCKERVERB", cat:"GUITAR AMP", name:"ORANGE Rockerverb", prices:{12:9000,24:12000,168:48000}, note:"" },
  { id:"YAMAHA-B100", cat:"BASS AMP", name:"YAMAHA B100 (コンボ)", prices:{12:5400,24:7200,168:28000}, note:"" },
  { id:"PEARL-DRUMSET", cat:"DRUM", name:"PEARL ドラムセット", prices:{12:10800,24:14400,168:60000}, note:"フル" },
  { id:"SHURE-SM57", cat:"MIC", name:"SHURE SM57", prices:{12:1200,24:2400,168:9000}, note:"" },
  { id:"SM58", cat:"MIC", name:"SHURE SM58", prices:{12:1200,24:2400,168:9000}, note:"" },
  { id:"WIRELESS", cat:"MIC", name:"ワイヤレスマイク（ハンド）", prices:{12:4500,24:7200,168:25000}, note:"" },
  { id:"EV-SX300", cat:"SPEAKER", name:"EV SX300 (スピーカー)", prices:{12:4800,24:6000,168:24000}, note:"パワード" },
  { id:"MIC-STAND", cat:"OPTION", name:"マイクスタンド", prices:{12:480,24:960,168:3600}, note:"" },
  { id:"CANARE-CABLE", cat:"OPTION", name:"シールド（1本）", prices:{12:360,24:720,168:2500}, note:"" }
];
/* ------------------------------------------------------------ */

/* state */
let state = {
  view: 'calendar', // 'calendar' or 'items'
  year: (new Date()).getFullYear(),
  month: (new Date()).getMonth(), // 0-index
  selectedDate: null, // 'YYYY-MM-DD'
  duration: 24,
  member:false,
  selections: {} // id: qty
};

const LS_KEY = 'rentalBookings_v1';

/* DOM */
const calGrid = document.getElementById('calGrid');
const monthLabel = document.getElementById('monthLabel');
const selectedDateEl = document.getElementById('selectedDate');
const chooseDateBtn = document.getElementById('chooseDate');
const itemsPanel = document.getElementById('itemsPanel');
const calendarPanel = document.getElementById('calendarPanel');
const itemsListEl = document.getElementById('itemsList');
const durationEl = document.getElementById('duration');
const memberEl = document.getElementById('member');
const totalEl = document.getElementById('total');
const exportArea = document.getElementById('exportArea');
const confirmBookingBtn = document.getElementById('confirmBooking');
const searchEl = document.getElementById('search');
const goToItemsBtn = document.getElementById('goToItems');
const backToCalBtn = document.getElementById('backToCal');
const prevBtn = document.getElementById('prev');
const nextBtn = document.getElementById('next');
const newBookingBtn = document.getElementById('newBooking');
const clearMarksBtn = document.getElementById('clearMarks');

/* utils */
const pad = n => n < 10 ? '0'+n : n;
const ymd = (y,m,d) => `${y}-${pad(m+1)}-${pad(d)}`;
const fmt = n => '¥' + n.toLocaleString('ja-JP');
const loadBookings = () => {
  try { return JSON.parse(localStorage.getItem(LS_KEY) || '{}'); } catch(e) { return {}; }
};
const saveBookings = (obj) => { localStorage.setItem(LS_KEY, JSON.stringify(obj)); };

/* calendar render */
function renderCalendar(){
  calGrid.innerHTML = '';
  const y = state.year, m = state.month;
  monthLabel.textContent = `${y}年 ${m+1}月`;
  const first = new Date(y,m,1);
  const startDay = first.getDay(); // 0..6
  const days = new Date(y, m+1, 0).getDate();
  // fill blanks
  for(let i=0;i<startDay;i++){
    const blank = document.createElement('div');
    blank.className = 'cal-cell';
    calGrid.appendChild(blank);
  }
  const bookings = loadBookings();
  for(let d=1; d<=days; d++){
    const cell = document.createElement('div');
    cell.className = 'cal-cell';
    const dayNum = document.createElement('div');
    dayNum.textContent = d;
    cell.appendChild(dayNum);

    const dateKey = ymd(y,m,d);
    // mark
    if (bookings[dateKey]){
      const mark = document.createElement('div');
      mark.className = 'mark';
      cell.appendChild(mark);
    }
    // highlight today
    const today = new Date();
    if (y===today.getFullYear() && m===today.getMonth() && d===today.getDate()){
      cell.classList.add('today');
    }
    // selected
    if (state.selectedDate === dateKey){
      cell.classList.add('selected');
    }
    cell.addEventListener('click', ()=>{
      state.selectedDate = dateKey;
      selectedDateEl.textContent = dateKey;
      chooseDateBtn.disabled = false;
      renderCalendar();
    });
    cell.addEventListener('dblclick', ()=>{
      // show bookings for that day
      showBookingsFor(dateKey);
    });
    calGrid.appendChild(cell);
  }
}

/* show bookings modal-like (simple) */
function showBookingsFor(dateKey){
  const bookings = loadBookings();
  const entry = bookings[dateKey];
  if (!entry){
    alert(dateKey + " の予約はありません。");
    return;
  }
  let txt = `予約日: ${dateKey}\n作成: ${new Date(entry.meta.createdAt).toLocaleString()}\n\n`;
  txt += '--- 機材 ---\n';
  entry.items.forEach((it, idx) => {
    txt += `${idx+1}. ${it.name} × ${it.qty} (単価 ${fmt(it.unit)}) → ${fmt(it.subtotal)}\n`;
  });
  txt += `\n合計: ${fmt(entry.total)}
